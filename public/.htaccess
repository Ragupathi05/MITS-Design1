# Correct MIME type for web manifest
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# Override CSP to allow eval (required by framer-motion and bundled libs)
<IfModule mod_headers.c>
  Header always unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https:; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https:;"
</IfModule>

# BrowserRouter support — rewrite all non-file requests to index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /university/

  # Skip real files, directories, and manifest
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.webmanifest$

  # Rewrite everything else to index.html
  RewriteRule ^ index.html [L]
</IfModule>
